# Copy to .env.local for your computer, and add the same names in Vercel, Settings, Environment Variables.
# Never commit real values. Never paste the service key into a chat or a screenshot.

# Supabase, Project Settings, API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server only. Used just by the public routes (lead form, webhooks, scheduler, backup report).
SUPABASE_SERVICE_ROLE_KEY=

# The address of your app, like https://crm.yourdomain.com
APP_URL=http://localhost:3000

# Make each of these a long random value. Mac, Linux or Windows:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LINK_SIGNING_SECRET=
CRON_SECRET=
BACKUP_REPORT_SECRET=
# Part of your public form address, so it's not a secret, but make it hard to guess (same command, 12 instead of 32)
LEAD_FORM_KEY=

# Resend: API key, and one signing secret per webhook (they start with whsec_)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_INBOUND_SECRET=

# Healthchecks.io ping address for the outside watchdog (the app's check, every 15 minutes)
HEALTHCHECK_PING_URL=
# The backup has its own Healthchecks check. Its address goes in the GitHub secret HEALTHCHECK_BACKUP_URL, not here.

# Websites allowed to show your lead form in a frame, space separated, https only.
# Leave empty to allow only a link to the form. Example: https://www.yourdomain.com https://yourdomain.com
LEAD_FORM_FRAME_ANCESTORS=

# Optional
DB_SIZE_LIMIT_MB=8192
DEMO_MODE=false
# EMAIL_ADAPTER=mock   (tests only: writes email to MOCK_EMAIL_LOG instead of sending)
SOURCE_URL=
