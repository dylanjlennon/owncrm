{
  "name": "owncrm",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "scan": "node scripts/scan-secrets.mjs",
    "test:rls": "bash scripts/test-rls-local.sh",
    "test:rest": "node scripts/test-rest.mjs",
    "test:restore": "bash scripts/test-restore-local.sh",
    "e2e": "NODE_USE_ENV_PROXY=1 NODE_NO_WARNINGS=1 node e2e/run.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "backup": "node scripts/backup.mjs",
    "gate": "node scripts/gate.mjs",
    "contract:check": "node contract/check.mjs",
    "contract:sql": "node contract/to-sql.mjs",
    "contract:schemas": "node contract/lib/gen-schemas.mjs",
    "rescue": "node rescue/bin/rescue.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "next": "15.5.29",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@types/node": "22.19.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.29",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "overrides": {
    "postcss": "8.5.32",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.5"
    }
  }
}
